{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${GROK_PLUGIN_ROOT}/hooks/desk_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write|Write|Edit|search_replace|Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${GROK_PLUGIN_ROOT}/hooks/protect_rules.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
