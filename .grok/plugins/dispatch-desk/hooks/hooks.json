{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${GROK_PLUGIN_ROOT}/hooks/desk_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "python ${GROK_PLUGIN_ROOT}/hooks/desk_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
